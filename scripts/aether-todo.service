# =====================================================================
# AETHER TODO SYSTEMD SERVICE TEMPLATE
# =====================================================================
# Návod k instalaci:
# 1. Upravte níže cesty k WorkingDirectory a ExecStart podle vaší instalace.
# 2. Zkopírujte tento soubor do /etc/systemd/system/:
#    sudo cp scripts/aether-todo.service /etc/systemd/system/
# 3. Znovu načtěte konfiguraci systemd:
#    sudo systemctl daemon-reload
# 4. Povolte spuštění služby při startu systému:
#    sudo systemctl enable aether-todo
# 5. Spusťte službu okamžitě:
#    sudo systemctl start aether-todo
#
# Diagnostika a logy:
# - Zkontrolovat stav služby: sudo systemctl status aether-todo
# - Zobrazit výpis logů:      sudo journalctl -u aether-todo -f
# =====================================================================

[Unit]
Description=Aether Todo-List Service (2026 Webapp)
After=network.target
# Stop restarting if the service crashes 5 times within 60s (avoids crash loops).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=box
# Files created by the service (DB, WAL, key, token) are owner-only.
UMask=0077
WorkingDirectory=/home/box/git/github/todo-list
# Build the frontend before starting so the SPA is always present.
ExecStartPre=/usr/bin/npm run build:frontend
ExecStart=/usr/bin/node /home/box/git/github/todo-list/server/index.js
Restart=on-failure
RestartSec=5
# To expose on the LAN, add HOST=0.0.0.0 below AFTER configuring API tokens.
Environment=PORT=3000 NODE_ENV=production
# Recommended: keep the at-rest encryption key OUT of the data directory.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then provide it here (or via systemd credentials / an EnvironmentFile with 0600):
# Environment=TODO_SECRET_KEY=<64-hex-chars>
# EnvironmentFile=/etc/aether-todo.env

[Install]
WantedBy=multi-user.target
