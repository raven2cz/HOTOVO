# =====================================================================
# HOTOVO — SYSTEMD SERVICE TEMPLATE
# =====================================================================
# Návod k instalaci:
# 1. Upravte níže cesty k WorkingDirectory a ExecStart podle vaší instalace.
# 2. Zkopírujte tento soubor do /etc/systemd/system/:
#    sudo cp scripts/hotovo.service /etc/systemd/system/
# 3. Znovu načtěte konfiguraci systemd:
#    sudo systemctl daemon-reload
# 4. Povolte spuštění služby při startu systému:
#    sudo systemctl enable hotovo
# 5. Spusťte službu okamžitě:
#    sudo systemctl start hotovo
#
# Diagnostika a logy:
# - Zkontrolovat stav služby: sudo systemctl status hotovo
# - Zobrazit výpis logů:      sudo journalctl -u hotovo -f
# =====================================================================

[Unit]
Description=HOTOVO task app (self-hosted, AI-agent API + Google Calendar sync)
After=network.target
# Stop restarting if the service crashes 5 times within 60s (avoids crash loops).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=box
# Files created by the service (DB, WAL, key, token) are owner-only.
UMask=0077
WorkingDirectory=/home/box/git/github/todo-list
# Build the frontend before starting so the SPA is always present.
ExecStartPre=/usr/bin/npm run build:frontend
ExecStart=/usr/bin/node /home/box/git/github/todo-list/server/index.js
Restart=on-failure
RestartSec=5
# Sandboxing: limit blast radius if the app or a dependency is compromised.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
# The app writes its SQLite DB / key / token files in the working directory.
# HARDENING (recommended): move runtime state out of the source tree so an app
# compromise can't modify source/build inputs and repo cleanup can't delete data:
#   StateDirectory=hotovo
#   Environment=DB_PATH=/var/lib/hotovo/todo.db TODO_SECRET_KEY=<64-hex>
#   ReadWritePaths=/var/lib/hotovo
# (then build the frontend at deploy time instead of ExecStartPre).
ReadWritePaths=/home/box/git/github/todo-list
# To expose on the LAN, add HOST=0.0.0.0 below AFTER configuring API tokens.
# Behind a reverse proxy, also set LOCAL_UI_BYPASS=false so EVERY /api request
# requires a token (proxied requests are otherwise refused the local bypass via
# forwarded-header detection, but this makes the intent explicit).
Environment=PORT=3000 NODE_ENV=production
# Recommended: keep the at-rest encryption key OUT of the data directory.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then provide it here (or via systemd credentials / an EnvironmentFile with 0600):
# Environment=TODO_SECRET_KEY=<64-hex-chars>
# EnvironmentFile=/etc/hotovo.env

[Install]
WantedBy=multi-user.target
