# Copy to .env and adjust. All values are optional and have safe defaults.

# Port the backend listens on.
PORT=3000

# Host/interface to bind. Defaults to loopback (local only). Set to 0.0.0.0 to
# expose on the LAN — ONLY after you have configured API tokens, since the API
# requires a token for any non-loopback caller.
HOST=127.0.0.1

# Runtime mode: production | development | test
NODE_ENV=production

# Comma-separated list of allowed CORS origins. Empty = same-origin only.
# CORS_ORIGINS=https://todo.example.com

# Local-UI auth bypass: same-origin loopback requests are trusted without a
# token (convenient for the UI on the device itself). Set to false for
# proxied/exposed deployments so EVERY /api request requires a token.
# LOCAL_UI_BYPASS=true

# Optional override for the SQLite database file path.
# DB_PATH=todo.db

# Public base URL of this server. Used to build the Google OAuth redirect URI
# default (<base>/api/sync/callback). Set this for LAN/proxy deployments so the
# generated redirect URI is reachable (must match what you register in Google).
# PUBLIC_BASE_URL=http://192.168.1.50:3000

# 32-byte hex key used to encrypt sensitive settings (OAuth secret / tokens)
# at rest. If unset, a key file is auto-generated next to the database.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TODO_SECRET_KEY=
