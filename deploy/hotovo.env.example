# Production env for an /opt/hotovo install. Copy to /opt/hotovo/etc/hotovo.env
# (chmod 0600, owned by the hotovo user) and fill in TODO_SECRET_KEY.

PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# Public URL (used for the Google OAuth redirect default). Must match the
# Authorized redirect URI registered in Google Cloud (+ /api/sync/callback).
# Port-forwarded model: nginx terminates TLS on 17854 (forward it in the router).
PUBLIC_BASE_URL=https://fishlive.org:17854

# Token-free bypass for the genuinely-local UI (e.g. an SSH tunnel to :3000 for
# admin / Google Calendar setup). Proxied requests (nginx adds X-Forwarded-* and
# a public Host) are auto-excluded, so this stays safe even for a public
# deployment - remote callers still need a Bearer token.
LOCAL_UI_BYPASS=true

# Runtime data lives outside the source tree (matches systemd ReadWritePaths).
DB_PATH=/opt/hotovo/data/todo.db

# 32-byte hex key encrypting OAuth secrets at rest. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TODO_SECRET_KEY=
